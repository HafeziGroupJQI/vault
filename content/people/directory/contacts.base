filters:
  and:
    - file.folder == "people"
    - type == "person"
    - group != "Alumni"
properties:
  title:
    displayName: Name
  role:
    displayName: Role
  building:
    displayName: Building
  office:
    displayName: Office
  email:
    displayName: Email
  scope:
    displayName: Ask me about
views:
  - type: table
    name: Current members
    filters:
      and:
        - group != "Alumni"
    order:
      - title
      - group
      - role
      - building
      - office
      - email
      - scope
    sort:
      - property: group
        direction: ASC
      - property: title
        direction: ASC
